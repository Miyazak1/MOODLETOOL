VITE_COURSE_CATALOG_URL=/course-catalog.json
VITE_COURSE_MANIFEST_URL=/courseware/ENG3U/course-manifest.json
VITE_COURSE_BASE_URL=/courseware/ENG3U/

# Optional, only for maintainer-side authenticated Moodle imports.
MOODLE_USERNAME=
MOODLE_PASSWORD=

# Local/private portal login. Courses ["*"] means all courses.
PORTAL_AUTH_ENABLED=1
PORTAL_SESSION_SECRET=replace-with-a-long-random-local-secret
PORTAL_DATA_DIR=./data
COURSE_STATUS_FILE=./data/course-status.json
COURSE_ACTIVE_ROOT=../courseware
COURSE_ARCHIVE_ROOT=../courseware-archive
COURSEWARE_ASSET_MODE=local
COURSEWARE_ASSET_BASE_URL=
COURSEWARE_ASSET_PREFIX=courseware-active
COURSEWARE_ASSET_REGISTRY_FILE=./deployment/asset-registry.json
COURSEWARE_OSS_ASSET_SCOPE=playable
OSS_BUCKET_URI=
OSSUTIL_PATH=ossutil
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_JOBS_ENABLED=0
MEDIA_JOBS_MAX_CONCURRENCY=1
MEDIA_JOBS_DATA_ROOT=./data/media-jobs
OSS_DIRECT_UPLOAD_ENABLED=0
OSS_DIRECT_UPLOAD_BUCKET=
OSS_DIRECT_UPLOAD_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
OSS_DIRECT_UPLOAD_INBOX_PREFIX=inbox/uploads
OSS_DIRECT_UPLOAD_MAX_GB=10
OSS_DIRECT_UPLOAD_TOKEN_TTL_SECONDS=1800
OSS_UPLOADS_DATA_ROOT=./data/oss-uploads
OSS_DIRECT_UPLOAD_ACCESS_KEY_ID=
OSS_DIRECT_UPLOAD_ACCESS_KEY_SECRET=
EMBED_TOKEN_SECRET=replace-with-a-long-random-local-embed-secret
EMBED_PUBLIC_ORIGIN=http://127.0.0.1:8891
PORTAL_USERS_JSON=[{"username":"admin","password":"local-admin-password","role":"admin","courses":["*"]},{"username":"teacher","password":"teacher-password","role":"teacher","courses":["ENG3U","ESLEO"]}]
