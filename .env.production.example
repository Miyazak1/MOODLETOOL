# Production uses one self-hosted cloud server by default.
# Keep catalog and courseware under the same protected domain/path unless this is changed deliberately.
VITE_COURSE_CATALOG_URL=/course-catalog.json
VITE_COURSE_MANIFEST_URL=/courseware/ENG3U/course-manifest.json
VITE_COURSE_BASE_URL=/courseware/ENG3U/

# Optional, only while running maintainer import scripts on the server.
# Do not expose these to the frontend.
MOODLE_USERNAME=
MOODLE_PASSWORD=

# Required for private deployment.
# Generate long random secrets and change all default passwords before going online.
# After creating .env.production, verify it with:
# npm run check:production-env -- --env .env.production
# Production startup should use:
# npm run start:production
PORTAL_AUTH_ENABLED=1
PORTAL_SESSION_SECRET=
PORTAL_COOKIE_SECURE=1
PORTAL_SESSION_MAX_AGE_SECONDS=43200
PORTAL_DATA_DIR=/www/wwwroot/ossd-portal/data
COURSE_STATUS_FILE=/www/wwwroot/ossd-portal/data/course-status.json
COURSE_ACTIVE_ROOT=/www/wwwroot/ossd-portal/courseware-active
COURSE_ARCHIVE_ROOT=/www/wwwroot/ossd-portal/courseware-archive
X_ACCEL_COURSEWARE_PREFIX=/_protected_courseware/

# Optional OSS + CDN asset delivery. Keep local until OSS/CDN has been configured and synced.
# local: all courseware assets continue through Portal/Nginx.
# hybrid: use CDN only for assets listed in asset-registry.json; fall back to local token URLs.
# cdn: always generate CDN URLs for courseware assets.
COURSEWARE_ASSET_MODE=local
COURSEWARE_ASSET_BASE_URL=
COURSEWARE_ASSET_PREFIX=courseware-active
COURSEWARE_ASSET_REGISTRY_FILE=/www/wwwroot/ossd-course-portal/deployment/asset-registry.json

EMBED_TOKEN_SECRET=
EMBED_PUBLIC_ORIGIN=https://your-domain.com
EMBED_TOKEN_MAX_AGE_SECONDS=315360000
PORTAL_USERS_JSON=[{"username":"admin","password":"CHANGE_ME_ADMIN_PASSWORD","role":"admin","courses":["*"]},{"username":"teacher1","password":"CHANGE_ME_TEACHER_PASSWORD","role":"teacher","courses":["ENG3U","ESLEO"]}]

# Failed login protection for both teacher portal and admin backend.
# Set LOGIN_RATE_LIMIT_MAX_FAILURES=0 only for a temporary trusted local test.
LOGIN_RATE_LIMIT_MAX_FAILURES=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCK_SECONDS=900

# Admin upload backend. Keep this separate from teacher portal access.
ADMIN_UPLOADS_ENABLED=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=1
ADMIN_MAX_DOCUMENT_MB=50
ADMIN_MAX_ISPRING_MB=4096
